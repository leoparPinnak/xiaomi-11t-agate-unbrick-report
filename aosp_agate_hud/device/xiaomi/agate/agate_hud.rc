service agate_charge_limit /system/bin/sh /system_ext/bin/agate_charge_limit.sh
    class late_start
    user root
    group root system
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    chmod 0664 /sys/class/power_supply/battery/input_suspend
    chown system system /sys/class/power_supply/battery/input_suspend
    start agate_charge_limit
