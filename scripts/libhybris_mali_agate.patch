 #include <libgen.h>
 #include <mntent.h>
 
@@ -2372,6 +2373,33 @@ struct open_redirect open_redirects[] = {
     { NULL, NULL }
 };
 
+static int _hybris_ion_fd = -1;
+
+static int _hybris_hook_ioctl(int fd, unsigned long req, void *arg)
+{
+    if (fd >= 0 && fd == _hybris_ion_fd) {
+        unsigned int *u = (unsigned int *)arg;
+        unsigned int nr = req & 0xff;
+        unsigned int typ = (req >> 8) & 0xff;
+        if (typ == 'I' && nr == 0 && arg != NULL) {
+            /* ion_allocation_data: len(u64 @ u[0..1]), heap_id_mask(u32 @ u[2]) or old align(u64)+heap_id(u32 @ u[4]) */
+            unsigned int sz = (req >> 16) & 0x3fff;
+            unsigned int heap_mask = (sz == 24) ? u[2] : ((sz >= 32) ? u[4] : 0);
+            if (heap_mask > 1 && (heap_mask & 1) == 0) {
+                errno = ENODEV;
+                return -1;
+            }
+        }
+    }
+    return ioctl(fd, req, arg);
+}
+
+int _hybris_hook_open(const char *pathname, int flags, ...);
+static int _hybris_hook___open_2(const char *pathname, int flags)
+{
+    return _hybris_hook_open(pathname, flags);
+}
+
 int _hybris_hook_open(const char *pathname, int flags, ...)
 {
     va_list ap;
@@ -2397,7 +2425,11 @@ int _hybris_hook_open(const char *pathname, int flags, ...)
             va_end(ap);
     }
 
-    return open(target_path, flags, mode);
+    int __ret = open(target_path, flags, mode);
+    if (__ret >= 0 && target_path && strcmp(target_path, "/dev/ion") == 0) {
+        _hybris_ion_fd = __ret;
+    }
+    return __ret;
 }
 
